<?xml version="1.0" encoding="utf-8"?>
<!--
	Auto-backup rules for API <= 30.
	The API key lives in the Keystore-encrypted wallhavend_secure_prefs file and must never leave
	the device; ordinary settings stay backup-eligible.
	See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
	<exclude domain="sharedpref" path="wallhavend_secure_prefs.xml" />
</full-backup-content>
