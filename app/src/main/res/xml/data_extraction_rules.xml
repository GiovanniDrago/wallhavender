<?xml version="1.0" encoding="utf-8"?>
<!--
	Data extraction rules for API >= 31.
	The API key lives in the Keystore-encrypted wallhavend_secure_prefs file and must never leave
	the device, neither through cloud backup nor through device transfer; ordinary settings stay
	backup-eligible.
	See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="sharedpref" path="wallhavend_secure_prefs.xml" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="sharedpref" path="wallhavend_secure_prefs.xml" />
	</device-transfer>
</data-extraction-rules>
